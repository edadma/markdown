{
  "scopeName": "source.scala",
  "name": "Scala",
  "fileTypes": ["scala", "sc", "sbt"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$",                 "name": "comment.line.double-slash.scala" },
        { "begin": "/\\*", "end": "\\*/",   "name": "comment.block.scala" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin":  "\"\"\"",
          "end":    "\"\"\"",
          "name":   "string.quoted.triple.scala"
        },
        {
          "begin":  "\"",
          "end":    "\"",
          "name":   "string.quoted.double.scala",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.scala" }
          ]
        },
        {
          "begin":  "'",
          "end":    "'",
          "name":   "string.quoted.single.scala",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.scala" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9a-fA-F_]+[lLfFdD]?\\b", "name": "constant.numeric.hex.scala" },
        { "match": "\\b0[bB][01_]+[lL]?\\b",            "name": "constant.numeric.binary.scala" },
        { "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?[fFdD]?\\b", "name": "constant.numeric.float.scala" },
        { "match": "\\b\\d[\\d_]*[lLfFdD]?\\b",         "name": "constant.numeric.scala" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(class|trait|object|enum|case|extends|with|derives|given|using|extension|inline|transparent|opaque|type|package|import|export|new|this|super)\\b",
          "name":  "keyword.declaration.scala"
        },
        {
          "match": "\\b(val|var|def|lazy|implicit|override|abstract|sealed|final|private|protected|public)\\b",
          "name":  "keyword.modifier.scala"
        },
        {
          "match": "\\b(if|else|then|match|for|while|do|yield|return|throw|try|catch|finally)\\b",
          "name":  "keyword.control.scala"
        },
        { "match": "\\b(true|false|null)\\b",  "name": "constant.language.scala" }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
          "name":  "entity.name.type.scala"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(=>|<-|->|=|\\+|-|\\*|/|%|<=|>=|<|>|==|!=|&&|\\|\\||!|\\?|::|\\+\\+|--)",
          "name":  "keyword.operator.scala"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": "[\\(\\)\\{\\}\\[\\]]",  "name": "punctuation.scala" },
        { "match": "[,;.:]",                "name": "punctuation.scala" }
      ]
    }
  }
}
